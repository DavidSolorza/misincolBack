{
  "info": {
    "_postman_id": "c1f7a8b4-8e3d-4c91-9a72-b7e123456789",
    "name": "Misincol Backend API (RBAC & LockWorkflow)",
    "description": "Colección completa de pruebas para la API REST de Misincol (NestJS), con autenticación RBAC, gestión de usuarios, sellado de planes (LockWorkflow), solicitudes de cambio, cron de notificaciones, objetivos, actividades y reportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleTeamId",
      "value": "team-wayuu",
      "type": "string"
    },
    {
      "key": "sampleObjectiveId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleActivityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleChangeRequestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Nacional Exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "    pm.test('Token JWT generado y guardado', () => {",
                  "        pm.expect(res.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@misincol.org\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Líder Exitoso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wayuu@misincol.org\",\n  \"password\": \"wayuu2026\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Usuarios (Users - RBAC)",
      "item": [
        {
          "name": "Crear Usuario (Exclusivo ROLE_NACIONAL)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lider.arhuaco@misincol.org\",\n  \"fullName\": \"Pastor Danilo Villafañe\",\n  \"password\": \"arhuaco2026\",\n  \"role\": \"ROLE_LIDER\",\n  \"teamId\": \"team-arhuaco\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Listar Usuarios (ROLE_NACIONAL)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        }
      ]
    },
    {
      "name": "3. Flujo de Sellado y Solicitudes de Cambio (LockWorkflow)",
      "item": [
        {
          "name": "Consultar Estado de Sellado del Plan",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/teams/team-wayuu/plan-status?year=2026", "host": ["{{baseUrl}}"], "path": ["teams", "team-wayuu", "plan-status"], "query": [{ "key": "year", "value": "2026" }] }
          }
        },
        {
          "name": "Sellar Plan como Terminado",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/teams/team-wayuu/finish-plan?year=2026", "host": ["{{baseUrl}}"], "path": ["teams", "team-wayuu", "finish-plan"], "query": [{ "key": "year", "value": "2026" }] }
          }
        },
        {
          "name": "Crear Solicitud de Cambio en Plan Sellado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('sampleChangeRequestId', res.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"team-wayuu\",\n  \"entityType\": \"ACTIVITY\",\n  \"action\": \"UPDATE\",\n  \"proposedData\": {\n    \"description\": \"Ajuste logístico de jornada médica y pastoral\",\n    \"unitBudget\": 400000\n  },\n  \"reason\": \"Crecimiento de asistentes y necesidad de suministros adicionales.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/change-requests", "host": ["{{baseUrl}}"], "path": ["change-requests"] }
          }
        },
        {
          "name": "Listar Solicitudes de Cambio (ROLE_NACIONAL)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/change-requests?status=PENDING", "host": ["{{baseUrl}}"], "path": ["change-requests"], "query": [{ "key": "status", "value": "PENDING" }] }
          }
        },
        {
          "name": "Aprobar Solicitud de Cambio (ROLE_NACIONAL)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/change-requests/{{sampleChangeRequestId}}/approve", "host": ["{{baseUrl}}"], "path": ["change-requests", "{{sampleChangeRequestId}}", "approve"] }
          }
        }
      ]
    },
    {
      "name": "4. Notificaciones y Auditoría Automática (Cron)",
      "item": [
        {
          "name": "Consultar Notificaciones del Usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Disparar Auditoría de Fechas Límite Manualmente",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/notifications/trigger-audit", "host": ["{{baseUrl}}"], "path": ["notifications", "trigger-audit"] }
          }
        }
      ]
    },
    {
      "name": "5. Reportes y Respaldos Masivos",
      "item": [
        {
          "name": "Respaldo Masivo en JSON",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/reports/backup/json", "host": ["{{baseUrl}}"], "path": ["reports", "backup", "json"] }
          }
        },
        {
          "name": "Respaldo Masivo en Excel",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/reports/backup/excel", "host": ["{{baseUrl}}"], "path": ["reports", "backup", "excel"] }
          }
        }
      ]
    }
  ]
}
