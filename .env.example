# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO CON GOOGLE (GMAIL / GOOGLE WORKSPACE)
# ==============================================================================
# Instrucciones para generar tu Contraseña de Aplicación de Google:
# 1. Ingresa a https://myaccount.google.com/security con tu cuenta de Google.
# 2. Asegúrate de tener activa la "Verificación en 2 pasos".
# 3. Busca en la barra de seguridad: "Contraseñas de aplicaciones" (App Passwords).
# 4. En "Nombre de la aplicación" escribe: Misincol
# 5. Haz clic en "Crear" y copia la contraseña de 16 letras generada (ej. abcd efgh ijkl mnop).
# 6. Pega esos valores en tu archivo local backend/.env (NUNCA en el chat ni en git).

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-correo@misincol.org
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Misincol Notificaciones <tu-correo@misincol.org>"

